{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build P2PFileTransfer",
            "command": "/usr/bin/g++-13",
            "args": [
                //"-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/application/P2PFileTransfer.cpp",  
                "-o",
                "${workspaceFolder}/application/P2PFileTransfer",  
                "-lpaho-mqttpp3", "-lpaho-mqtt3a", "-lpthread",  
                "-I${workspaceFolder}/framework", 
                "-I${workspaceFolder}/algorithm"  
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task for compiling P2PFileTransfer.cpp."
        }
    ],
    "version": "2.0.0"
}
